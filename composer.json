{
    "name": "fdc-jez/computer-parts-inventory",
    "description": "Inventory and point-of-sale system for a computer parts shop (native PHP).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "dompdf/dompdf": "^3.1",
        "monolog/monolog": "^3.12",
        "nikic/fast-route": "^1.3",
        "picqer/php-barcode-generator": "^3.3",
        "robmorgan/phinx": "^0.16.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php",
            "src/icons.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8010 -t public public/index.php",
        "migrate": "phinx migrate",
        "seed": "phinx seed:run",
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    }
}
