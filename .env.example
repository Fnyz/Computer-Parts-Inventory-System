# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, set these as Environment Variables instead of using a file.

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=partsdesk
DB_USER=root
DB_PASS=
# XAMPP on macOS: connect through its socket file instead of host/port
# DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
# Aiven (or any managed MySQL that needs TLS): path to ca.pem, or paste the certificate text itself
DB_SSL_CA=

# ---- App ----
APP_TIMEZONE=Asia/Manila
# Only if the app is served from a sub-folder, e.g. /inventory
APP_BASE_PATH=
# true shows error details in the browser. Only on your own machine, never on Render.
APP_DEBUG=false
# stderr on Render (logs show in the dashboard); empty = storage/logs/app.log
LOG_CHANNEL=

# ---- Product images ----
# Empty = saved in public/uploads (fine locally). On Render use Cloudinary, because Render's free disk is wiped on every deploy:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ---- Shop details printed on receipts ----
SHOP_NAME=PartsDesk Computer Parts
SHOP_ADDRESS=
SHOP_PHONE=
